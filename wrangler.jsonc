{
  // Static-asset Worker. There is no server-side code — `dist` is uploaded
  // as-is and Cloudflare serves it from the edge.
  //
  // Deploy:  npm run deploy   (the GitHub Action runs the same command)
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bcsave-preview",
  // Pinned so a deploy can never land in the wrong account — this login has
  // access to two, and only this one serves the URL that has been shared.
  "account_id": "00804eb9ff865dd924e8e8cd6fb23f93",
  "compatibility_date": "2026-08-05",
  // Serves the live ShelterManager routes under /api/. Everything else is a
  // static file and never reaches this code — see the note in src/worker.js.
  "main": "./src/worker.js",
  "assets": {
    "directory": "./dist",
    // Named so the Worker can hand non-/api/ requests straight back to the
    // asset server.
    "binding": "ASSETS",
    // Assets are matched before the Worker, and `not_found_handling` below
    // makes the asset router claim every unmatched path — which swallowed the
    // API routes and answered them with the 404 page. These prefixes go to the
    // Worker first; everything else still short-circuits to a static file.
    "run_worker_first": ["/api/*"],
    // Serve /dogs/bear for /dogs/bear/ and vice versa, and use our styled
    // 404.html rather than Cloudflare's default.
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
