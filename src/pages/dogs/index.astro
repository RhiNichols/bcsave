---
import Base from "../../layouts/Base.astro";
import DogCard from "../../components/DogCard.astro";
import { dogs, locations, ageGroup } from "../../data/dogs";
import { forms } from "../../data/links";

// Sort puppies and younger dogs first — that is what most visitors arrive for,
// and it keeps the top of the grid lively.
const order = { puppy: 0, young: 1, adult: 2, senior: 3 } as const;
const sorted = [...dogs].sort(
  (a, b) => order[ageGroup(a)] - order[ageGroup(b)]
);

const regions = locations();

// Chip counts, so nobody taps a filter that returns nothing.
const counts = { puppy: 0, young: 0, adult: 0, senior: 0 };
for (const d of dogs) counts[ageGroup(d)]++;
---

<Base
  title={`${dogs.length} Border Collies Available for Adoption — BCSAVE`}
  description="Browse every Border Collie currently available for adoption through Border Collie Save & Rescue in Central and North Texas."
  ctaLabel="Apply to Adopt"
  ctaHref={forms.adopt}
>
  <section class="section section--tight">
    <div class="wrap">
      <p class="eyebrow">Available dogs</p>
      <h1 style="font-size: clamp(1.9rem, 5.5vw, 3rem);">
        <span data-dog-count>{dogs.length}</span> dogs are looking for homes
      </h1>
      <p class="lede">
        Every one is in a foster home right now. Tap a dog to read their story.
        Do not see the right fit? New dogs come in most weeks.
      </p>

      {/* Filled in only after the live ShelterManager read succeeds, so it can
          never claim a connection that is not working. */}
      <p class="live-status" id="live-status" hidden></p>
    </div>
  </section>

  <section class="wrap" style="padding-bottom: 4rem;">
    <!-- Filters are progressive enhancement: without JS every dog shows. -->
    <div class="filters" role="group" aria-label="Filter dogs">
      <p class="filters__label" id="f-age">Age</p>
      {/* One wrapper span on purpose. .chip is inline-flex, so bare text and
          the count become separate flex items and the space between them is
          dropped — it rendered "All64". Inside a single element the text lays
          out normally and the space survives. The other chips escape this
          because their count sits inside brackets. */}
      <button class="chip" data-filter="all" aria-pressed="true">
        <span>All <span data-chip-count>{dogs.length}</span></span>
      </button>
      <button class="chip" data-filter="age:puppy" aria-pressed="false">
        Puppies (<span data-chip-count>{counts.puppy}</span>)
      </button>
      <button class="chip" data-filter="age:young" aria-pressed="false">
        Under 3 (<span data-chip-count>{counts.young}</span>)
      </button>
      <button class="chip" data-filter="age:adult" aria-pressed="false">
        Adults (<span data-chip-count>{counts.adult}</span>)
      </button>
      {
        counts.senior > 0 && (
          <button class="chip" data-filter="age:senior" aria-pressed="false">
            Seniors (<span data-chip-count>{counts.senior}</span>)
          </button>
        )
      }

      <p class="filters__label">Sex</p>
      <button class="chip" data-filter="sex:Female" aria-pressed="false">Female</button>
      <button class="chip" data-filter="sex:Male" aria-pressed="false">Male</button>

      <p class="filters__label">Region</p>
      {
        regions.map((r) => (
          <button class="chip" data-filter={`location:${r}`} aria-pressed="false">
            {r.replace(/\s*\(.*\)/, "")}
          </button>
        ))
      }
    </div>

    <p id="filter-count" class="lede" aria-live="polite" style="font-size: 0.95rem;"></p>

    <ul class="dog-grid" id="dog-grid">
      {sorted.map((dog, i) => <DogCard dog={dog} eager={i < 6} level={2} />)}
    </ul>

    <p id="filter-empty" class="notice" hidden>
      No dogs match that filter right now. Try another, or
      <a href={forms.adopt}>apply anyway</a> — we match people to dogs as they come in.
    </p>
  </section>

  <section class="section section--tight band">
    <div class="wrap center">
      <h2 style="color: var(--white);">Not sure which dog is right?</h2>
      <p style="color: rgba(255,253,249,0.88); max-width: 52ch; margin-inline: auto;">
        Apply anyway. We match people to dogs, not the other way round — and the
        dog who suits you may not have arrived yet.
      </p>
      <div class="btn-row mt-2" style="justify-content: center;">
        <a class="btn btn--light" href={forms.adopt}>Start an application</a>
        <a class="btn btn--ghost" style="color: #fffdf9;" href={forms.foster}>
          Foster instead
        </a>
      </div>
    </div>
  </section>
</Base>

<script>
  import { refreshGrid, recount, showLiveStatus } from "../../lib/live-dogs";

  const chips = document.querySelectorAll<HTMLButtonElement>(".chip");
  const grid = document.getElementById("dog-grid");
  const empty = document.getElementById("filter-empty");
  const count = document.getElementById("filter-count");

  if (grid && empty && count) {
    let current = "all";

    // Re-queried rather than captured: the live refresh below adds and removes
    // cards after this runs, and a stale list would filter dogs that are gone.
    const cardsNow = () => Array.from(grid.querySelectorAll<HTMLElement>(".dog"));

    const apply = (filter: string) => {
      current = filter;
      const [key, value] = filter.split(":");
      const cards = cardsNow();
      let shown = 0;

      for (const card of cards) {
        const match = key === "all" || card.dataset[key] === value;
        card.hidden = !match;
        if (match) shown++;
      }

      empty.hidden = shown > 0;
      count.textContent =
        filter === "all" ? "" : `Showing ${shown} of ${cards.length} dogs`;
    };

    for (const chip of chips) {
      chip.addEventListener("click", () => {
        for (const c of chips) c.setAttribute("aria-pressed", "false");
        chip.setAttribute("aria-pressed", "true");
        apply(chip.dataset.filter ?? "all");
      });
    }

    // Filters work from the first paint; this only corrects the data behind
    // them. A failed refresh returns null and the page is left exactly as
    // built.
    refreshGrid(grid).then((result) => {
      if (!result) return;
      recount(grid);
      apply(current);

      const status = document.getElementById("live-status");
      if (status) showLiveStatus(status, result);
    });
  }
</script>
