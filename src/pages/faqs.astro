---
import Base from "../layouts/Base.astro";
import { forms } from "../data/links";

/*
 * Condensed from BCSAVE's own FAQ at bcsave.org/faqs/. Wording is tightened
 * but no policy has been changed or invented — if any of this is out of date,
 * the source of truth is the rescue, not this file.
 */
const groups = [
  {
    id: "adopting",
    title: "Adopting",
    items: [
      {
        q: "What is the adoption fee, and what does it cover?",
        a: [
          "Fees depend on the dog:",
          "**Special Treasures — $100.** Seniors over eight, or dogs with a known medical condition or a need for atypical training and handling.",
          "**Puppies under six months — $350.** Adopted under a spay/neuter contract.",
          "**All other dogs — $300.**",
          "Every dog comes with core vaccinations (distemper, adenovirus, parvovirus, parainfluenza), bordetella, rabies, and a heartworm test. Unless noted otherwise, dogs over six months are spayed or neutered before they go home.",
        ],
      },
      {
        q: "What does the adoption process look like?",
        a: [
          "1. A volunteer is assigned to your application and reaches out for an initial interview. This can take up to two weeks — please check your spam folder.",
          "2. They then conduct a virtual home visit.",
          "3. Once the interview, home visit and other checks are done, you are recommended for approval and a board member talks with you about the kind of dog you are looking for.",
          "4. Together we identify a dog we think fits, and connect you with their foster to learn more and arrange a meet and greet.",
          "5. If the rescue, the foster and you all think it is a good fit, we move forward.",
        ],
      },
      {
        q: "How long does it take?",
        a: [
          "Getting approved usually takes less than a few weeks. Finding the right dog can take longer.",
          "We encourage applicants to get approved with more than one rescue — we cannot guarantee how long a match will take.",
        ],
      },
      {
        q: "How do home visits work?",
        a: [
          "Virtually, through a mix of photos, video and web calls. We usually ask for several pictures of the inside and outside of your home, especially the pet areas, plus the yard and fences if you have them.",
          "We can also do the visit live over Zoom or Google Meet, whichever you prefer.",
        ],
      },
      {
        q: "Can I apply for one specific dog?",
        a: [
          "You can tell us who caught your eye, and we want to know — it helps us understand what you are drawn to.",
          "In practice most dogs are adopted by people already approved and waiting, so we work to match you with a dog who suits your home. That may not be the one you first spotted.",
        ],
      },
      {
        q: "What if more than one person wants the same dog?",
        a: [
          "The board, with a recommendation from the foster, chooses from the approved applicants whichever placement we believe gives that dog the best outcome.",
        ],
      },
      {
        q: "Do you offer foster-to-adopt or trial adoptions?",
        a: [
          "Yes, for adopters in the Dallas/Fort Worth and Austin areas — it lets you bring a dog home and see how things go, which matters especially if you have other pets.",
          "We cannot offer the same trial to out-of-area or out-of-state adopters, because getting a dog back is far harder logistically.",
        ],
      },
      {
        q: "Do you adopt out of state?",
        a: [
          "We prioritise adopters who can come to the DFW or Austin areas to meet our dogs and finalise locally.",
          "We do adopt out of state, but not every dog — only those we think can succeed with the travel and transition. Out-of-state adopters go through additional interviews, and are responsible for arranging and paying for transport.",
          "Adopters may collect in person at no extra cost. Or a dog can fly as airline cargo — we have used American and Delta — at roughly $350–$450 or higher including the travel carrier. That is harder to arrange when temperatures are forecast above 85°F, and the adopter coordinates every part of it: crate, flight accessories, health certificate and the airline itself.",
          "Paid ground transporters are a third option, averaging $150–$175 with the dog on the road for one to four days. It is not an option we are focusing on at the moment, but ask if it would make the difference.",
          "We ask every out-of-state adopter to commit to returning the dog to us, at their cost, if the adoption does not work out — rather than rehoming or surrendering locally.",
          "If you cannot travel right now but want to start the process anyway and be placed on a pending list once approved, tell us.",
        ],
      },
    ],
  },
  {
    id: "our-dogs",
    title: "Our dogs",
    items: [
      {
        q: 'Why are some dogs marked "No Longer Accepting Applications" or "Texas Adoptions Only"?',
        a: [
          "**No Longer Accepting Applications** — that dog received a large number of applications, so we stopped taking more and will choose from those already approved.",
          "**Texas Adoptions Only** — some dogs are harder to place, and many have been adopted and returned at least once. Keeping those adoptions inside Texas means the dog can come back to us easily if it does not work out.",
        ],
      },
      {
        q: 'What is a "sport" assessment?',
        a: [
          "Occasionally a very high-drive dog is fostered for four to twelve weeks with a sporting foster who tests their drive for disc, agility, ball, tug and similar.",
          "If that dog turns out to need far more structured physical and mental work than an average home provides, we place them somewhere that competes or trains regularly — disc, agility, search and rescue, performance or trick training.",
        ],
      },
      {
        q: "Where are you located? Can we visit your facility?",
        a: [
          "There is no facility. We are 100% foster based, with homes across Texas and occasionally in Oklahoma and Louisiana.",
          "Most dogs go first to a staging foster for an initial assessment, then into a longer-term foster home until they are adopted.",
        ],
      },
      {
        q: "Why adopt from a rescue rather than a shelter?",
        a: [
          "Look at both. It is a personal choice and shelters do essential work — we partner with them.",
          "The difference is what we can know. Because our dogs live in homes, we learn far more about who they actually are, which lets us match dog to household properly. We are not working against intake pressure, so we can take the time to vet adopters. And our dogs usually arrive vaccinated, on heartworm prevention, spayed or neutered, and often house, leash and crate trained.",
          "If you adopt from a shelter, take in a stray, or simply spay and neuter your own pet, you are still saving a life. That is the actual goal.",
        ],
      },
    ],
  },
  {
    id: "found-a-dog",
    title: "Found a dog?",
    items: [
      {
        q: "I found a stray Border Collie. Will you take it?",
        a: [
          "As a policy, we do not take in stray or found dogs.",
          "Lost dogs travel a long way, and even with flyers and neighbourhood apps an owner may never learn their dog was found. County and city shelters are the first place most people look, so we recommend contacting your local shelter.",
          "If you do take a Border Collie to a shelter, please tell us which shelter, any intake or ID number, and anything you know about the dog. We can then follow that dog and start looking for a foster for once the stray hold ends.",
          "Many shelters also run in-home foster programmes where you keep the dog while the shelter publishes it as found — and will often release the dog to a rescue after the stray hold.",
        ],
      },
      {
        q: "Are there exceptions?",
        a: [
          "Occasionally — for example when a dog was clearly abandoned after owners moved, or a stray has been in the area a long time.",
          "If you think yours is a special circumstance, fill out the Owner Surrender Questionnaire and we will review it with you.",
        ],
      },
      {
        q: "The dog has a BCSAVE tag or microchip.",
        a: [
          "Then it is one of ours and we want to hear immediately. Go to our lost dog page and fill out the form — someone will be with you as soon as possible.",
        ],
      },
    ],
  },
];

/** Bold **text** without pulling in a markdown dependency. */
function emphasise(text: string): string {
  return text
    .replace(/&/g, "&amp;")
    .replace(/</g, "&lt;")
    .replace(/>/g, "&gt;")
    .replace(/\*\*(.+?)\*\*/g, "<strong>$1</strong>");
}
---

<Base
  title="FAQs — Adopting from Border Collie Save & Rescue"
  description="Adoption fees, the application process, home visits, out-of-state adoption, and what to do if you have found a Border Collie in Texas."
>
  <section class="section section--tight">
    <div class="wrap">
      <p class="eyebrow">Questions</p>
      <h1 style="max-width: 14ch;">Answers before you apply.</h1>
      <p class="lede">
        If something is not covered here, ask us — we would rather answer twice
        than have you guess.
      </p>

      <nav class="filters mt-2" aria-label="Jump to a section">
        {
          groups.map((g) => (
            <a class="chip" href={`#${g.id}`}>
              {g.title}
            </a>
          ))
        }
      </nav>
    </div>
  </section>

  {
    groups.map((group, gi) => (
      <section
        class="section section--tight"
        id={group.id}
        style={gi % 2 === 1 ? "background: var(--paper-warm);" : undefined}
      >
        <div class="wrap">
          <h2>{group.title}</h2>
          <div class="faq mt-2">
            {group.items.map((item) => (
              <details class="faq__item">
                <summary>
                  <span>{item.q}</span>
                  <svg class="faq__chev" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <polyline points="6 9 12 15 18 9" />
                  </svg>
                </summary>
                <div class="faq__body">
                  {item.a.map((p) => (
                    <p set:html={emphasise(p)} />
                  ))}
                </div>
              </details>
            ))}
          </div>
        </div>
      </section>
    ))
  }

  <section class="section section--tight band">
    <div class="wrap center">
      <h2 style="color: var(--white);">Ready when you are.</h2>
      <p style="color: rgba(255,253,249,0.88); max-width: 50ch; margin-inline: auto;">
        Applications are read by volunteers, so give us a few days to come back
        to you.
      </p>
      <div class="btn-row mt-2" style="justify-content: center;">
        <a class="btn btn--light" href={forms.adopt}>Adoption application</a>
        <a class="btn btn--ghost" style="color: #fffdf9;" href={forms.surrender}>
          Owner surrender
        </a>
      </div>
    </div>
  </section>
</Base>
