---
import { forms } from "../data/links";

interface Props {
  /** Left-hand action. Defaults to browsing dogs. */
  label?: string;
  href?: string;
}

// On the dogs list, "Meet the Dogs" points at the page you are already on —
// so pages can override the secondary action with something useful.
const { label = "Meet the Dogs", href = "/dogs" } = Astro.props;
---

<div class="sticky-cta">
  <a class="btn btn--ghost" href={href}>{label}</a>
  <a class="btn btn--ember" href="/donate">Donate</a>
</div>
