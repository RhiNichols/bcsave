---
/*
 * Where BCSAVE actually adopts and fosters.
 *
 * Every claim here comes from the rescue's own published pages — the FAQ
 * ("Do you adopt out of state?", "Where are you located?"), the adoption
 * application preamble ("OUT OF STATE ADOPTIONS"), and the foster application
 * preamble ("OUT OF STATE"). Nothing is invented. It lives in a component
 * rather than being retyped per page because it is policy: if the rescue
 * changes the rule, it should change in one file.
 *
 * It exists because that information was previously only reachable by opening
 * a FAQ accordion — which is after somebody has already fallen for a dog. The
 * volunteers who screen applications carry the cost of that.
 */
interface Props {
  /** Heading level, so the block does not break the page outline. */
  level?: 2 | 3;
}

const { level = 2 } = Astro.props;
const H = `h${level}` as "h2" | "h3";
const Sub = `h${level + 1}` as "h3" | "h4";

const tiers = [
  {
    title: "Dallas/Fort Worth & Austin",
    badge: "First priority",
    body:
      "We prioritise adopters who can come to the DFW or Austin areas to meet " +
      "a dog and finalise the adoption locally. Foster-to-adopt and trial " +
      "adoptions are offered here, so you and the dog both get a say.",
  },
  {
    title: "Texas & neighbouring states",
    badge: "Where our dogs live",
    body:
      "We are 100% foster based, with homes across Texas and — in rare cases — " +
      "Oklahoma and Louisiana. Applicants willing to travel to the dog's foster " +
      "home get the same priority as local ones.",
  },
  {
    title: "Elsewhere in the US",
    badge: "Case by case",
    body:
      "We do adopt out of state, but not every dog — only those we think can " +
      "handle the travel and settle well. Expect extra interviews, a longer " +
      "wait, and transport you arrange and pay for.",
  },
];
---

<section class="section section--tight service-area" id="where-we-adopt">
  <div class="wrap">
    <p class="eyebrow">Where we adopt</p>
    <H>Texas first — but not Texas only.</H>
    <p class="lede">
      We are an all-volunteer rescue with no paid staff, so how far a dog has to
      travel is a real constraint. It does not rule you out; it decides how long
      things take and who arranges what.
    </p>

    <div class="tiers mt-2">
      {
        tiers.map((t) => (
          <article class="tier">
            <p class="tier__badge">{t.badge}</p>
            <Sub class="tier__title">{t.title}</Sub>
            <p class="tier__body">{t.body}</p>
          </article>
        ))
      }
    </div>

    <p class="service-area__note mt-2">
      <strong>Fostering is Texas and the immediately surrounding areas only.</strong>{" "}
      If you live further out and want to help, our{" "}
      <a href="/faqs#adopting">FAQ</a>{" "}covers the out-of-state adoption process
      in full — including transport costs and timelines.
    </p>
  </div>
</section>

<style>
  /* Its own tone on purpose. On the homepage this sits between a warm section
     and a plain one, so neither of those would separate it from a neighbour. */
  .service-area {
    background: var(--accent-wash);
    border-block: 1px solid var(--accent-line);
  }

  .service-area .eyebrow {
    color: var(--accent-ink);
  }

  /* Deliberately not .notice — that is ember-toned and fights the blue band. */
  .service-area__note {
    background: var(--white);
    border: 1px solid var(--accent-line);
    border-radius: var(--radius);
    padding: 0.9rem 1.1rem;
    font-size: 0.92rem;
    line-height: 1.6;
    color: var(--ink-soft);
  }

  .service-area__note strong {
    color: var(--ink);
  }

  .tiers {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
  }

  .tier {
    background: var(--white);
    border: 1px solid var(--accent-line);
    border-radius: var(--radius-lg);
    padding: 1.35rem 1.4rem;
    /* The left edge reads as a scale from "closest" to "furthest". */
    border-left: 4px solid var(--accent);
  }

  .tier:nth-child(2) {
    border-left-color: color-mix(in srgb, var(--accent) 45%, var(--white));
  }

  .tier:nth-child(3) {
    border-left-color: var(--accent-line);
  }

  .tier__badge {
    font-family: var(--font-body);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--accent-ink);
    margin-bottom: 0.35rem;
  }

  .tier:nth-child(3) .tier__badge {
    color: var(--ink-soft);
  }

  .tier__title {
    font-size: 1.08rem;
    line-height: 1.25;
    margin-bottom: 0.5rem;
  }

  .tier__body {
    color: var(--ink-soft);
    font-size: 0.95rem;
    line-height: 1.6;
  }
</style>
