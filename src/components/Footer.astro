---
import { forms, social, shop } from "../data/links";
const year = new Date().getFullYear();
---

<footer class="ftr">
  <div class="wrap ftr__grid">
    <div>
      <img
        class="ftr__logo"
        src="/logo-white.png"
        alt="Border Collie Save &amp; Rescue"
        width="560"
        height="406"
        loading="lazy"
        decoding="async"
      />
      <p>
        An all-volunteer 501(c)(3) nonprofit rescuing, rehabbing and rehoming
        Border Collies and Border Collie mixes across Central and North Texas.
      </p>
      <div class="social">
        <a href={social.facebook} aria-label="Facebook" rel="noopener" target="_blank">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M22 12a10 10 0 1 0-11.5 9.86v-6.96H8v-2.9h2.5V9.84c0-2.48 1.49-3.85 3.77-3.85 1.09 0 2.23.2 2.23.2v2.46H15c-1.24 0-1.63.77-1.63 1.56v1.88h2.78l-.44 2.9h-2.34v6.96A10 10 0 0 0 22 12z"></path>
          </svg>
        </a>
        <a href={social.instagram} aria-label="Instagram" rel="noopener" target="_blank">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <rect x="2" y="2" width="20" height="20" rx="5"></rect>
            <circle cx="12" cy="12" r="4"></circle>
            <circle cx="17.5" cy="6.5" r="1.2" fill="currentColor" stroke="none"></circle>
          </svg>
        </a>
      </div>
    </div>

    <div>
      <h3>Adopt &amp; Help</h3>
      <ul>
        <li><a href="/dogs">Available Dogs</a></li>
        <li><a href="/alumni">Alumni</a></li>
        <li><a href={forms.adopt}>Adoption Application</a></li>
        <li><a href={forms.foster}>Foster Application</a></li>
        <li><a href={forms.volunteer}>Volunteer Application</a></li>
        <li><a href={forms.surrender}>Owner Surrender</a></li>
      </ul>
    </div>

    <div>
      <h3>Support</h3>
      <ul>
        <li><a href="/about">About Us</a></li>
        <li><a href="/donate">Donate</a></li>
        <li><a href={shop} rel="noopener" target="_blank">Shop</a></li>
        <li><a href="https://bcsave.org/events/">Events</a></li>
        <li><a href="/faqs">FAQs</a></li>
        <li><a href="/lostdog">Found a Stray Dog?</a></li>
      </ul>
    </div>
  </div>

  <div class="wrap">
    <div class="ftr__legal">
      <span>&copy; {year} Border Collie Save and Rescue, Inc. All rights reserved.</span>
      <span>501(c)(3) nonprofit &middot; Springtown, TX</span>
    </div>
  </div>
</footer>
